# Generators compare canonical bytes on every platform, including Windows checkout.
/generated/*.ts text eol=lf
/generated/*.json text eol=lf
/src-tauri/permissions/autogenerated/*.toml text eol=lf

# ACL revisions hash raw component templates and generated manifests.
# Prevent Git for Windows from changing those bytes at checkout.
/public/components/**/*.html text eol=lf
/public/acl-manifest.json text eol=lf
/public/acl-routes/*.json text eol=lf

# Hash-pinned patches must retain canonical bytes on Windows checkouts
/patches/*.patch text eol=lf

# Vendored fixtures retain their original upstream bytes, including CRLF and binary archives.
/tests/fixtures/plugins/vendor/** -text
