+        CloseHandle(dev->input_ready_stop);
+        CloseHandle(dev->input_ready_rearm);
+        dev->input_ready_thread = NULL;
+    }
+    dev->input_ready_callback = NULL;
+    dev->input_ready_context = NULL;
+    InterlockedExchange(&dev->input_ready_failed, 0);
+    if (!callback) return 0;
+    dev->input_ready_stop = CreateEvent(NULL, TRUE, FALSE, NULL);
+    dev->input_ready_rearm = CreateEvent(NULL, FALSE, FALSE, NULL);
+    if (!dev->input_ready_stop || !dev->input_ready_rearm) goto failure;
+    dev->input_ready_callback = callback;
+    dev->input_ready_context = context;
+    dev->input_ready_thread = CreateThread(NULL, 0, input_ready_thread, dev, 0, NULL);
+    if (dev->input_ready_thread) return 0;
+failure:
+    if (dev->input_ready_stop) CloseHandle(dev->input_ready_stop);
+    if (dev->input_ready_rearm) CloseHandle(dev->input_ready_rearm);
+    dev->input_ready_stop = dev->input_ready_rearm = NULL;
+    dev->input_ready_callback = NULL;
+    dev->input_ready_context = NULL;
+    return -1;
