+int HID_API_EXPORT HID_API_CALL hid_winapi_set_input_ready_callback(hid_device *dev,
+    void (*callback)(void *), void *context)
+{
+    if (dev->input_ready_thread) {
+        SetEvent(dev->input_ready_stop);
+        /* Callback only signals independent state; it must never call HIDAPI. */
