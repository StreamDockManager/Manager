+/* Callback must only signal independent state, never call back into HIDAPI. */
+void HID_API_EXPORT hid_darwin_set_input_ready_callback(hid_device *dev,
+    void (*callback)(void *), void *context)
+{
+    pthread_mutex_lock(&dev->mutex);
+    dev->input_ready_callback = callback;
+    dev->input_ready_context = context;
+    if (callback && (dev->input_reports || dev->disconnected || dev->shutdown_thread))
+        callback(context);
+    pthread_mutex_unlock(&dev->mutex);
+}
+
+static void notify_input_ready(hid_device *dev)
+{
+    /* Caller holds dev->mutex. Unregister waits for an active callback. */
+    if (dev->input_ready_callback)
+        dev->input_ready_callback(dev->input_ready_context);
+}
 
