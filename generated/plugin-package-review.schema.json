{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PluginPackageReview",
  "type": "object",
  "properties": {
    "can_import": {
      "type": "boolean"
    },
    "can_run": {
      "type": "boolean"
    },
    "channel": {
      "type": "string"
    },
    "channel_change": {
      "type": "boolean"
    },
    "compatibility": {
      "$ref": "#/$defs/PluginPreflight"
    },
    "compatible": {
      "type": "boolean"
    },
    "force_reinstall_available": {
      "type": "boolean"
    },
    "id": {
      "type": "string"
    },
    "installed_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "manifest": {
      "$ref": "#/$defs/NormalizedManifest"
    },
    "package": {
      "$ref": "#/$defs/PackageCandidate"
    },
    "permission_diff": {
      "anyOf": [
        {
          "$ref": "#/$defs/PermissionDiff"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "retained_services": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ActionScope"
      }
    },
    "retained_slots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/VaultSetupSlot"
      }
    },
    "reviewable_services": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/ActionScope"
      }
    },
    "source": {
      "$ref": "#/$defs/PackageSource"
    },
    "suggested_profiles": {
      "anyOf": [
        {
          "$ref": "#/$defs/PluginProfileCatalog"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "trusted": {
      "type": "boolean"
    },
    "version_change": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "trusted",
    "package",
    "channel",
    "channel_change",
    "compatible",
    "force_reinstall_available",
    "manifest",
    "source",
    "compatibility",
    "can_import",
    "can_run"
  ],
  "$defs": {
    "ActionPermissions": {
      "type": "object",
      "properties": {
        "optional": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/PermissionScope"
          }
        },
        "purpose": {
          "type": "string"
        },
        "required": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/PermissionScope"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "purpose"
      ]
    },
    "ActionScope": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "scope": {
          "$ref": "#/$defs/PermissionScope"
        }
      },
      "required": [
        "action",
        "required",
        "scope"
      ]
    },
    "CompatibilityCheck": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "level": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "remedy": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "level",
        "message",
        "remedy"
      ]
    },
    "NormalizedManifest": {
      "type": "object",
      "properties": {
        "action_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "control_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dialect": {
          "type": "string"
        },
        "entry_point": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "permissions": {
          "anyOf": [
            {
              "$ref": "#/$defs/PermissionDeclaration"
            },
            {
              "type": "null"
            }
          ]
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "publisher": {
          "type": [
            "string",
            "null"
          ]
        },
        "runtime_kind": {
          "type": "string"
        },
        "setup_slots": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/VaultSetupSlot"
          }
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "version",
        "dialect",
        "entry_point",
        "runtime_kind",
        "platforms",
        "action_count",
        "control_types"
      ]
    },
    "PackageCandidate": {
      "type": "object",
      "properties": {
        "architectures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "id": {
          "type": "string"
        },
        "minimum_manager": {
          "type": "string"
        },
        "os": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sha256": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "files",
        "os",
        "id",
        "version",
        "path",
        "sha256",
        "size",
        "architectures",
        "minimum_manager",
        "required_capabilities"
      ]
    },
    "PackageSource": {
      "type": "object",
      "properties": {
        "filename": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "format",
        "filename",
        "sha256"
      ]
    },
    "PermissionDeclaration": {
      "type": "object",
      "properties": {
        "actions": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/ActionPermissions"
          }
        },
        "version": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "actions"
      ]
    },
    "PermissionDiff": {
      "type": "object",
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActionScope"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActionScope"
          }
        },
        "unchanged": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActionScope"
          }
        }
      },
      "required": [
        "added",
        "removed",
        "unchanged"
      ]
    },
    "PermissionScope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "const": "ui.popup"
            },
            "mode": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "id",
            "mode"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "const": "ui.notification"
            },
            "mode": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "id",
            "mode"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "const": "notifications.create"
            },
            "mode": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "id",
            "mode"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "const": "clipboard.read-text"
            },
            "mode": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "id",
            "mode"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "const": "clipboard.write-text"
            },
            "mode": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "id",
            "mode"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data_class": {
              "type": "string"
            },
            "id": {
              "type": "string",
              "const": "network.https"
            },
            "origin": {
              "type": "string"
            },
            "recipe": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "id",
            "origin",
            "recipe",
            "data_class"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data_class": {
              "type": "string"
            },
            "id": {
              "type": "string",
              "const": "network.http"
            },
            "origin": {
              "type": "string"
            },
            "recipe": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "id",
            "origin",
            "recipe",
            "data_class"
          ]
        },
        {
          "type": "object",
          "properties": {
            "entry_kind": {
              "type": "string"
            },
            "field": {
              "type": "string"
            },
            "id": {
              "type": "string",
              "const": "vault.read-location"
            },
            "purpose": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "id",
            "field",
            "entry_kind",
            "purpose"
          ]
        },
        {
          "type": "object",
          "properties": {
            "entry_kind": {
              "type": "string"
            },
            "field": {
              "type": "string"
            },
            "id": {
              "type": "string",
              "const": "vault.read-secret"
            },
            "purpose": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "id",
            "field",
            "entry_kind",
            "purpose"
          ]
        },
        {
          "type": "object",
          "properties": {
            "entry_kind": {
              "type": "string"
            },
            "field": {
              "type": "string"
            },
            "id": {
              "type": "string",
              "const": "vault.write-secret"
            },
            "purpose": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "id",
            "field",
            "entry_kind",
            "purpose"
          ]
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string"
            },
            "id": {
              "type": "string",
              "const": "vault.access"
            },
            "mode": {
              "type": "string"
            },
            "operation": {
              "type": "string"
            },
            "origin": {
              "type": "string"
            },
            "recipe": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "id",
            "mode",
            "field",
            "operation",
            "recipe",
            "origin"
          ]
        }
      ]
    },
    "PluginPreflight": {
      "type": "object",
      "properties": {
        "can_enable": {
          "type": "boolean"
        },
        "can_install": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CompatibilityCheck"
          }
        },
        "id": {
          "type": "string"
        },
        "installed": {
          "type": "boolean"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "runtime": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimeResolution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "version",
        "source",
        "kind",
        "installed",
        "checks",
        "can_install",
        "can_enable"
      ]
    },
    "PluginProfileCatalog": {
      "type": "object",
      "properties": {
        "can_configure": {
          "type": "boolean"
        },
        "fingerprint": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "plugin_id": {
          "type": "string"
        },
        "suggestions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PluginProfileSuggestion"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "plugin_id",
        "name",
        "fingerprint",
        "can_configure",
        "suggestions",
        "warnings"
      ]
    },
    "PluginProfileSuggestion": {
      "type": "object",
      "properties": {
        "binding_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "type": "string"
        },
        "model_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "page_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "unavailable_actions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "key",
        "name",
        "model_id",
        "page_count",
        "binding_count",
        "unavailable_actions"
      ]
    },
    "RuntimeInstallation": {
      "type": "object",
      "properties": {
        "channel": {
          "type": "string"
        },
        "executable": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/RuntimeKind"
        },
        "line": {
          "type": "string"
        },
        "provenance": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "verification": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "channel",
        "line",
        "version",
        "executable",
        "source",
        "verification",
        "provenance"
      ]
    },
    "RuntimeKind": {
      "type": "string",
      "enum": [
        "nodejs"
      ]
    },
    "RuntimeRequirement": {
      "type": "object",
      "properties": {
        "channel": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/RuntimeKind"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "channel"
      ]
    },
    "RuntimeResolution": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "overridden": {
          "type": "boolean"
        },
        "recommended_line": {
          "type": [
            "string",
            "null"
          ]
        },
        "requirement": {
          "$ref": "#/$defs/RuntimeRequirement"
        },
        "selected": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuntimeInstallation"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "type": "string"
        }
      },
      "required": [
        "requirement",
        "state",
        "message",
        "overridden"
      ]
    },
    "VaultSetupSlot": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "entry_kind": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "fields": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "mode": {
          "type": "string"
        },
        "operation": {
          "type": [
            "string",
            "null"
          ]
        },
        "origin": {
          "type": [
            "string",
            "null"
          ]
        },
        "precision": {
          "type": [
            "string",
            "null"
          ]
        },
        "purpose": {
          "type": "string"
        },
        "recipe": {
          "type": [
            "string",
            "null"
          ]
        },
        "recipient": {
          "type": [
            "string",
            "null"
          ]
        },
        "required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "entry_kind",
        "mode",
        "required",
        "purpose",
        "field",
        "action"
      ]
    }
  }
}