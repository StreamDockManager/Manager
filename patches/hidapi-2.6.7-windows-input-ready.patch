+/* Manager readiness observer: no reads and no report ownership. */
+static DWORD WINAPI input_ready_thread(void *context)
+{
+    hid_device *dev = context;
+    HANDLE ready[] = {dev->input_ready_stop, dev->ol.hEvent};
+    HANDLE rearm[] = {dev->input_ready_stop, dev->input_ready_rearm};
+    for (;;) {
+        DWORD result = WaitForMultipleObjects(2, ready, FALSE, INFINITE);
+        if (result == WAIT_OBJECT_0) return 0;
+        if (result != WAIT_OBJECT_0 + 1) break;
+        dev->input_ready_callback(dev->input_ready_context);
+        result = WaitForMultipleObjects(2, rearm, FALSE, INFINITE);
+        if (result == WAIT_OBJECT_0) return 0;
+        if (result != WAIT_OBJECT_0 + 1) break;
+    }
+    InterlockedExchange(&dev->input_ready_failed, 1);
+    dev->input_ready_callback(dev->input_ready_context);
+    return 0;
+}
